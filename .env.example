# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mcq_dev

# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID).
# Authorized redirect URIs must include:
#   http://localhost:8000/accounts/google/login/callback/
#   http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SITE_DOMAIN=localhost:8000

# Anthropic Claude API key, used only to ingest uploaded question-bank files.
ANTHROPIC_API_KEY=

# Set to True to skip the real Claude API call during manual testing and use
# a naive local parser instead (see ingestion/services.py for the expected
# fake-mode file format: numbered questions, lettered options, then an
# "Answer Key" section with lines like "1. B").
MCQ_INGESTION_FAKE=False
